+    test("known 199 byte POM uses its response length") {
+      val pom = "<project><modelVersion>4.0.0</modelVersion><groupId>test</groupId>" +
+        "<artifactId>tiny</artifactId><version>1</version></project>"
+      val expectedBody = (pom + (" " * (199 - pom.length))).getBytes("UTF-8")
+      assert(expectedBody.length == 199)
+      val observation = downloadScenario(expectedBody, Some(199L), None, None)
+      assertScenario(observation, expectedBody, 199L, 199)
+    }
+
+    test("known one byte response uses a one byte buffer") {
+      val expectedBody = Array[Byte](42)
+      val observation = downloadScenario(expectedBody, Some(1L), None, None)
+      assertScenario(observation, expectedBody, 1L, 1)
+    }
+
+    test("identity response uses its uncompressed length") {
+      val expectedBody = Array[Byte](11, 22, 33)
+      val observation = downloadScenario(expectedBody, Some(3L), Some("identity"), None)
+      assertScenario(observation, expectedBody, 3L, 3)
+    }
+
+    test("other content encodings retain the default maximum") {
+      val expectedBody = Array[Byte](11, 22, 33)
+      val observation = downloadScenario(expectedBody, Some(3L), Some("custom"), None)
+      assertScenario(observation, expectedBody, 3L, CacheDefaults.bufferSize)
+      assert(observation.reads.exists(_.arrayLength == CacheDefaults.bufferSize))
+    }
+
+    test("known responses at the default boundary stay bounded") {
+      for (length <- Seq(CacheDefaults.bufferSize - 1, CacheDefaults.bufferSize, CacheDefaults.bufferSize + 1)) {
+        val expectedBody = Array.tabulate[Byte](length)(index => (index % 251).toByte)
+        val observation = downloadScenario(expectedBody, Some(length.toLong), None, None)
+        assertScenario(observation, expectedBody, length.toLong, math.min(length, CacheDefaults.bufferSize))
+        assert(observation.reads.exists(_.arrayLength == math.min(length, CacheDefaults.bufferSize)))
+      }
+    }
+
